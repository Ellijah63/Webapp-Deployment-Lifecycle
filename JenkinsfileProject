pipeline {
    agent any
    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'Dev', description: 'Specify the branch name to deploy') 
    }
    stages {
        stage("CHECKOUT") {
            steps {
              script {
                  // Checkout for specified branch using parameter
                  def branchName = params.BRANCH_NAME
                  checkout([$class: 'GitSCM', branches: [[name: branchName]], userRemoteConfigs: [[url: 'https://github.com/Ellijah63/Webapp-Deployment-Lifecycle.git']]])
              }
            }
         }
        stage("TEST") {
			steps {
				echo "Test Runs"

			}
		}
		stage("BUILD") {
			steps {
				sh "mvn clean package"
				sh "mv target/ROOT.war target/Webapp-Deployment-Lifecycle.war"
			}
		}
		stage("Dev Deployment") {
			when {
				expression { params.BRANCH_NAME == 'Dev' }
			}
			steps {
				echo "Deploying to Dev Webserver"
				deploy adapters: [
					tomcat11(
						credentialsId: 'tomcat-creds',
						path: '',
						url: 'http://10.0.0.173:8080/manager/text'
					)
				],
				contextPath: '/Webapp-Deployment-Lifecycle',
				war: 'target/target/Webapp-Deployment-Lifecycle.war'
			}
		}
		stage("Qa Deployment") {
			when {
				expression { params.BRANCH_NAME == 'Qa' }
			}
			steps {
				echo "Deploying to Qa Webserver"
				deploy adapters: [
					tomcat11(
						credentialsId: 'tomcat-creds',
						path: '',
						url: 'http://10.0.0.147:8080/manager/text'
					)
				],
				contextPath: '/Webapp-Deployment-Lifecycle',
				war: 'target/target/Webapp-Deployment-Lifecycle.war'
			}
		}
		stage("Prod Deployment") {
			when {
				expression { params.BRANCH_NAME == 'main' }
			}
			steps {
				echo "Deploying to Prod Webserver"
				input(message: "Do you want to proceed to PROD?", ok: "Proceed")
				deploy adapters: [
					tomcat11(
						credentialsId: 'tomcat-creds',
						path: '',
						url: 'http://10.0.0.17:8080/manager/text'
					)
				],
				contextPath: '/Webapp-Deployment-Lifecycle',
				war: 'target/target/Webapp-Deployment-Lifecycle.war'
			}
		}
	}
}				
